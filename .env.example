# Database
DATABASE_URL=postgresql+asyncpg://openwiki:openwiki@db:5432/openwiki
POSTGRES_USER=openwiki
POSTGRES_PASSWORD=openwiki
POSTGRES_DB=openwiki

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY=base64-encoded-32-byte-key

# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Embedding
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=bge-m3
OPENAI_EMBED_MODEL=text-embedding-3-small

# Langfuse
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_DATABASE_URL=postgresql://openwiki:openwiki@db:5432/openwiki
LANGFUSE_NEXTAUTH_SECRET=change-me-langfuse-nextauth
LANGFUSE_SALT=change-me-langfuse-salt

# Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10

# App
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=80
WIKI_MAX_DOC_CONTENT_KB=32
WIKI_INGEST_DEBOUNCE_SECONDS=30
RETRIEVAL_TOP_K=8
RRF_K=60
CHAT_HISTORY_TURNS=10
CORS_ORIGINS=http://localhost:5173

